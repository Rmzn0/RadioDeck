<Window x:Class="RadioDeck.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:RadioDeck.Services.Localization"
        Title="{loc:T Gen_PinHeading}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocSource.Instance}}"
        Width="340"
        SizeToContent="Height"
        Background="#121212"
        Foreground="#E6E6E6"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18">
        <TextBlock Text="{loc:T Pin_Prompt}" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <PasswordBox x:Name="PinBox" MaxLength="32" FontSize="16" FlowDirection="LeftToRight" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"/>
        <TextBlock x:Name="ErrorText" Foreground="#FF5252" Margin="0,8,0,0" MinHeight="18" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:T Btn_Cancel}" IsCancel="True" MinWidth="90" Margin="0,0,10,0"/>
            <Button Content="{loc:T Btn_Ok}" IsDefault="True" MinWidth="90" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
