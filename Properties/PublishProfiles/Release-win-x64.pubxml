<?xml version="1.0" encoding="utf-8"?>
<!-- Visual Studio publish profile: one self-contained EXE for 64-bit Windows.
     The scripts in .\scripts publish a folder instead (used by the installer). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <!-- Self-contained: the .NET runtime is included, nothing has to be installed. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Single file -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- ReadyToRun: faster start-up -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- WPF and the SIP library use reflection; trimming would break them. -->
    <PublishTrimmed>false</PublishTrimmed>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
