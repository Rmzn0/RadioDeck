<Window x:Class="RadioDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:RadioDeck.Converters"
        xmlns:loc="clr-namespace:RadioDeck.Services.Localization"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocSource.Instance}}"
        Title="{Binding WindowTitle}"
        Topmost="{Binding AlwaysOnTop}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Loaded="MainWindow_Loaded"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None"
        Background="#121212"
        Foreground="#E6E6E6"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Icon="radio.png">

    <Window.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#121212"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2A2D2E"/>
        <SolidColorBrush x:Key="HeaderBlue" Color="#0288D1"/>
        <SolidColorBrush x:Key="ActiveGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="WarnAmber" Color="#FFB300"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#FF5252"/>
        <SolidColorBrush x:Key="PassiveGray" Color="#7C93A0"/>
        <SolidColorBrush x:Key="RxTxCardFg" Color="#E6E6E6"/>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:VuBarGridLengthConverter x:Key="VuBarGridLengthConverter"/>
        <conv:AnyActivityConverter x:Key="AnyActivityConverter"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style x:Key="RxTxCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Background" Value="#191C1D"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource RxTxCardFg}"/>
            <Style.Triggers>
                <!-- Each RX/TX card sets Tag (via MultiBinding) to its own "activity" value. -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ActiveGreen}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Connection lamp: grey = off, amber = connecting or half connected, green = connected, red = failed. -->
        <Style x:Key="StateDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{StaticResource PassiveGray}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                    <Setter Property="Fill" Value="{StaticResource ActiveGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Connecting">
                    <Setter Property="Fill" Value="{StaticResource WarnAmber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Partial">
                    <Setter Property="Fill" Value="{StaticResource WarnAmber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Fill" Value="{StaticResource ErrorRed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding StatusText}"/>
            <Setter Property="ToolTip" Value="{Binding StatusText}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource PassiveGray}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Connected">
                    <Setter Property="Foreground" Value="#7BD88F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Connecting">
                    <Setter Property="Foreground" Value="{StaticResource WarnAmber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Partial">
                    <Setter Property="Foreground" Value="{StaticResource WarnAmber}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#DCE4E8"/>
            <Setter Property="Background" Value="#263238"/>
            <Setter Property="BorderBrush" Value="#455A64"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#37474F"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3A4044"/>
        </Style>

        <Style x:Key="ConnectButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Content" Value="{Binding ConnectButtonText}"/>
            <Setter Property="Command" Value="{Binding ToggleConnectCommand}"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="BorderBrush" Value="#42A5F5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConnectAction}" Value="Disconnect">
                    <Setter Property="Background" Value="#263238"/>
                    <Setter Property="BorderBrush" Value="#607D8B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ConnectAction}" Value="Cancel">
                    <Setter Property="Background" Value="#5D4037"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WarnAmber}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small on/off switch used for "monitor" and "PTT key selects this radio". -->
        <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="Background" Value="#202526"/>
            <Setter Property="BorderBrush" Value="#3A4044"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#0D47A1"/>
                    <Setter Property="BorderBrush" Value="#42A5F5"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#90A4AE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <LinearGradientBrush x:Key="VuFillBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E676" Offset="0.00"/>
            <GradientStop Color="#8BC34A" Offset="0.55"/>
            <GradientStop Color="#FFC107" Offset="0.82"/>
            <GradientStop Color="#FF5252" Offset="1.00"/>
        </LinearGradientBrush>

        <Style x:Key="VuBarStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource VuFillBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2F3539"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
                            <Grid Margin="1" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition>
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource VuBarGridLengthConverter}" ConverterParameter="fill">
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                    <ColumnDefinition>
                                        <ColumnDefinition.Width>
                                            <MultiBinding Converter="{StaticResource VuBarGridLengthConverter}" ConverterParameter="rest">
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            </MultiBinding>
                                        </ColumnDefinition.Width>
                                    </ColumnDefinition>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="5"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Each bar sets Tag to its own "signal detected" property. -->
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="BorderBrush" Value="#00E676"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="TickMarksTemplate" TargetType="ContentControl">
            <Grid Margin="6,0,6,0" Opacity="0.25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="1" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="2" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="3" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="4" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="5" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="6" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
                <Border Grid.Column="7" BorderBrush="#AAB0B4" BorderThickness="1,0,0,0"/>
            </Grid>
        </ControlTemplate>

        <Style x:Key="PttButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
            <Setter Property="Content" Value="{Binding PttButtonText}"/>
            <Setter Property="IsEnabled" Value="{Binding CanPtt}"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#37474F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#607D8B"/>
            <Setter Property="ToolTip" Value="{loc:T Card_TipPtt}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding PttOn}" Value="True">
                    <Setter Property="Background" Value="#C62828"/>
                    <Setter Property="BorderBrush" Value="#EF5350"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FrequencyStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{Binding FrequencyDisplay}"/>
            <Setter Property="ToolTip" Value="{Binding FrequencyHint}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource PassiveGray}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LinkUp}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ActiveGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding FrequencyStale}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFrequencyEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LampTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================ classic card ============================ -->
        <DataTemplate x:Key="ClassicCardTemplate">
            <Border Style="{StaticResource CardBorderStyle}" Width="370" Height="368" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderBlue}" CornerRadius="6" Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="38">
                                <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="Bold"
                                           Foreground="#FFFFFF" ToolTip="{Binding EndpointSummary}"/>
                            </Viewbox>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,2,0">
                                <materialDesign:PackIcon Kind="LanConnect" Width="16" Height="16" Margin="0,0,6,0"
                                                         Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Border Background="#0D1B24" CornerRadius="7" Width="14" Height="14">
                                    <Ellipse Style="{StaticResource StateDotStyle}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource ConnectButtonStyle}" Height="30" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Height="62">
                        <TextBlock Style="{StaticResource FrequencyStyle}"
                                   Margin="4,4,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   MouseLeftButtonDown="FrequencyText_MouseDown"/>

                        <Border Background="#202427" BorderBrush="#3A4044" BorderThickness="1" CornerRadius="6"
                                Padding="8,0" Margin="4,8,4,6"
                                Visibility="{Binding IsFrequencyEditing, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                                <TextBox Width="130" Height="34" Margin="0"
                                         Text="{Binding FrequencyInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" FontSize="18" MaxLength="8" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         IsVisibleChanged="FrequencyEditor_IsVisibleChanged" FlowDirection="LeftToRight"
                                         KeyDown="FrequencyEditor_KeyDown"/>
                                <TextBlock Text="MHz" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.6"/>
                                <Button Content="{loc:T Card_Set}" Command="{Binding SetFrequencyCommand}" Margin="10,0,0,0"
                                        Height="32" MinWidth="52" Style="{StaticResource FlatButtonStyle}"/>
                                <Button Content="{loc:T Card_Cancel}" Command="{Binding CancelFrequencyEditCommand}" Margin="6,0,0,0"
                                        Height="32" Style="{StaticResource FlatButtonStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource StatusTextStyle}" Margin="6,0,6,8"/>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RX -->
                        <Border Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource RxTxCardStyle}">
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTx}" Value="False">
                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Tag>
                                <MultiBinding Converter="{StaticResource AnyActivityConverter}">
                                    <Binding Path="RxLevel"/>
                                    <Binding Path="RxSignalDetected"/>
                                </MultiBinding>
                            </Border.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <materialDesign:PackIcon Kind="VolumeHigh" Width="22" Height="22" Margin="0,0,6,0"
                                                             Foreground="{StaticResource RxTxCardFg}" VerticalAlignment="Center"/>
                                    <TextBlock Text="RX" FontSize="26" FontWeight="Bold"/>
                                    <Ellipse Width="10" Height="10" Margin="8,10,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource PassiveGray}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RxSignalDetected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource ActiveGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock DockPanel.Dock="Right" Text="SQ" ToolTip="{loc:T Card_TipSquelch}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource LampTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RxSquelch}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ActiveGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Grid>
                                        <ProgressBar Style="{StaticResource VuBarStyle}"
                                                     Value="{Binding RxLevel, Mode=OneWay}"
                                                     Tag="{Binding RxSignalDetected, Mode=OneWay}"/>
                                        <ContentControl Template="{StaticResource TickMarksTemplate}" IsHitTestVisible="False" Focusable="False"/>
                                    </Grid>
                                    <TextBlock Text="{Binding RxLevel, Mode=OneWay, StringFormat={}{0}%}"
                                               Margin="0,6,0,0" FontFamily="Consolas" FontSize="14" Opacity="0.75"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- Same height as the PTT button so both meters line up. -->
                                <Grid Grid.Row="2" Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" Style="{StaticResource ChipToggleStyle}" Height="30"
                                                  IsChecked="{Binding RxMonitor}"
                                                  ToolTip="{loc:T Card_TipMonitor}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Headphones" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="MON" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="200" SmallChange="5" LargeChange="20"
                                            Value="{Binding RxVolume}" Margin="10,0,2,0" VerticalAlignment="Center"
                                            Focusable="False" IsEnabled="{Binding RxMonitor}"
                                            ToolTip="{loc:T Card_TipVolume}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- TX -->
                        <Border Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource RxTxCardStyle}"
                                Visibility="{Binding HasTx, Converter={StaticResource BoolToVisibility}}">
                            <Border.Tag>
                                <MultiBinding Converter="{StaticResource AnyActivityConverter}">
                                    <Binding Path="TxLevel"/>
                                    <Binding Path="TxSignalDetected"/>
                                    <Binding Path="PttOn"/>
                                </MultiBinding>
                            </Border.Tag>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" LastChildFill="False">
                                    <materialDesign:PackIcon Kind="Microphone" Width="22" Height="22" Margin="0,0,6,0"
                                                             Foreground="{StaticResource RxTxCardFg}" VerticalAlignment="Center"/>
                                    <TextBlock Text="TX" FontSize="26" FontWeight="Bold"/>
                                    <Ellipse Width="10" Height="10" Margin="8,10,0,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource PassiveGray}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TxSignalDetected}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource ActiveGreen}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ChipToggleStyle}"
                                                  IsChecked="{Binding TxSelected}"
                                                  ToolTip="{loc:T Card_TipKey}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Keyboard" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="KEY" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DockPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <Grid>
                                        <ProgressBar Style="{StaticResource VuBarStyle}"
                                                     Value="{Binding TxLevel, Mode=OneWay}"
                                                     Tag="{Binding TxSignalDetected, Mode=OneWay}"/>
                                        <ContentControl Template="{StaticResource TickMarksTemplate}" IsHitTestVisible="False" Focusable="False"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding TxLevel, Mode=OneWay, StringFormat={}{0}%}"
                                                   FontFamily="Consolas" FontSize="14" Opacity="0.75"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="ON AIR" HorizontalAlignment="Right"
                                                   ToolTip="{loc:T Card_TipOnAir}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource LampTextStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TxConfirmed}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>

                                <Button Grid.Row="2" Style="{StaticResource PttButtonStyle}"
                                        PreviewMouseLeftButtonDown="PttButton_MouseDown"
                                        PreviewMouseLeftButtonUp="PttButton_MouseUp"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ============================ square grid tile ============================ -->
        <DataTemplate x:Key="GridTileTemplate">
            <Border Width="236" Height="236" Margin="4" Padding="8" CornerRadius="8" BorderThickness="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PanelBackground}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RxSignalDetected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource ActiveGreen}"/>
                                <Setter Property="Background" Value="#16261A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PttOn}" Value="True">
                                <Setter Property="BorderBrush" Value="#EF5350"/>
                                <Setter Property="Background" Value="#2A1616"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- name + connection -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderBlue}" CornerRadius="5" Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                       Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding EndpointSummary}"/>
                            <Border Grid.Column="1" Background="#0D1B24" CornerRadius="7" Width="14" Height="14" Margin="6,0,0,0">
                                <Ellipse Style="{StaticResource StateDotStyle}" HorizontalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource ConnectButtonStyle}" Height="22" MinWidth="74"
                                    FontSize="11" Padding="6,0" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- frequency -->
                    <Grid Grid.Row="1" Height="44">
                        <TextBlock Style="{StaticResource FrequencyStyle}" FontSize="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MouseLeftButtonDown="FrequencyText_MouseDown"/>
                        <DockPanel LastChildFill="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding IsFrequencyEditing, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Width="96" Height="30" Margin="0" Padding="2,0"
                                     Text="{Binding FrequencyInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="16" MaxLength="8" materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     IsVisibleChanged="FrequencyEditor_IsVisibleChanged" FlowDirection="LeftToRight"
                                     KeyDown="FrequencyEditor_KeyDown"/>
                            <Button Content="{loc:T Card_Set}" Command="{Binding SetFrequencyCommand}" Margin="6,0,0,0"
                                    Height="28" Padding="8,0" Style="{StaticResource FlatButtonStyle}"/>
                            <Button Content="X" Command="{Binding CancelFrequencyEditCommand}" Margin="4,0,0,0"
                                    Height="28" Padding="8,0" Style="{StaticResource FlatButtonStyle}"/>
                        </DockPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Style="{StaticResource StatusTextStyle}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,2"/>

                    <!-- meters -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RX" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Style="{StaticResource VuBarStyle}" Height="14"
                                         Value="{Binding RxLevel, Mode=OneWay}"
                                         Tag="{Binding RxSignalDetected, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="SQ" HorizontalAlignment="Right"
                                       ToolTip="{loc:T Card_TipSquelch}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LampTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RxSquelch}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ActiveGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="0,8,0,0" Visibility="{Binding HasTx, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TX" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="1" Style="{StaticResource VuBarStyle}" Height="14"
                                         Value="{Binding TxLevel, Mode=OneWay}"
                                         Tag="{Binding TxSignalDetected, Mode=OneWay}"/>
                            <TextBlock Grid.Column="2" Text="AIR" HorizontalAlignment="Right"
                                       ToolTip="{loc:T Card_TipOnAir}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource LampTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TxConfirmed}" Value="True">
                                                <Setter Property="Foreground" Value="#FF8A80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- switches -->
                    <Grid Grid.Row="4" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Style="{StaticResource ChipToggleStyle}" Margin="0,0,3,0"
                                      IsChecked="{Binding RxMonitor}"
                                      ToolTip="{loc:T Card_TipMonitor}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Headphones" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="MON" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ChipToggleStyle}" Margin="3,0,0,0"
                                      IsChecked="{Binding TxSelected}"
                                      Visibility="{Binding HasTx, Converter={StaticResource BoolToVisibility}}"
                                      ToolTip="{loc:T Card_TipKey}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Keyboard" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="KEY" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <Button Grid.Row="5" Style="{StaticResource PttButtonStyle}" Height="40"
                            Visibility="{Binding HasTx, Converter={StaticResource BoolToVisibility}}"
                            PreviewMouseLeftButtonDown="PttButton_MouseDown"
                            PreviewMouseLeftButtonUp="PttButton_MouseUp"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Classic: tall cards, two per column, further radios continue to the right. -->
        <ItemsPanelTemplate x:Key="ClassicPanel">
            <WrapPanel Orientation="Vertical" MaxHeight="760"/>
        </ItemsPanelTemplate>

        <!-- Grid: square tiles in list order, four per row, then the next row. -->
        <ItemsPanelTemplate x:Key="GridPanel">
            <UniformGrid Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                         HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="10" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock Text="RadioDeck" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButtonStyle}"
                    Command="{Binding OpenSettingsCommand}" ToolTip="{loc:T Main_Settings}">
                <materialDesign:PackIcon Kind="Cog" Width="18" Height="18"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButtonStyle}"
                    Command="{Binding OpenLogCommand}" ToolTip="{loc:T Main_Log}">
                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButtonStyle}"
                    Command="{Binding ToggleViewCommand}" ToolTip="{Binding ViewToggleToolTip}">
                <materialDesign:PackIcon Kind="ViewGrid" Width="18" Height="18"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource HeaderIconButtonStyle}"
                    Command="{Binding ToggleConnectAllCommand}" ToolTip="{Binding ConnectAllToolTip}">
                <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18"/>
            </Button>
        </DockPanel>

        <StackPanel Grid.Row="1" MaxWidth="{Binding ActualWidth, ElementName=RadioList}" HorizontalAlignment="Stretch">
            <Border Background="#B71C1C" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding TransmitLimitReached, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:T Main_TxLimit}"
                           Foreground="#FFFFFF" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#3E2F00" BorderBrush="{StaticResource WarnAmber}" BorderThickness="1" CornerRadius="6"
                    Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Notice}" Foreground="#FFE082" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <ItemsControl x:Name="RadioList" Grid.Row="2" ItemsSource="{Binding Radios}" Margin="-4"
                      HorizontalAlignment="Left" Focusable="False">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemTemplate" Value="{StaticResource ClassicCardTemplate}"/>
                    <Setter Property="ItemsPanel" Value="{StaticResource ClassicPanel}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGridMode}" Value="True">
                            <Setter Property="ItemTemplate" Value="{StaticResource GridTileTemplate}"/>
                            <Setter Property="ItemsPanel" Value="{StaticResource GridPanel}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#1A1D1E" BorderBrush="#2A2D2E" BorderThickness="0,1,0,0"
                Padding="10,6" Margin="0,10,0,0" MinHeight="38" CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding PttKeyText}" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="#8899A6"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding FooterLogo}" Height="24" Width="24" Margin="0,0,6,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"
                           Visibility="{Binding HasFooterLogo, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Organization}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                               Foreground="#8899A6" Margin="0,0,10,0"
                               Visibility="{Binding HasOrganization, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock x:Name="VersionText" VerticalAlignment="Center" FontSize="11" Foreground="#5F6F7A"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
